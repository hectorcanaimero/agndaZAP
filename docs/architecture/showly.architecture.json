  "cards": [
    {
      "dot": "cyan",
      "title": "Stack tecnológico",
      "items": [
        "Backend: NestJS 10 + Prisma 5 + TypeScript strict",
        "DB: PostgreSQL 15 + pgvector (embeddings)",
        "Jobs: Redis 7 + BullMQ (recordatorios)",
        "Frontend: Next.js 15 + Tailwind + shadcn/ui + next-intl (es/pt)",
        "WhatsApp: WAHA (Docker, no oficial, engine Baileys)",
        "LLM: Router multi-provider (DeepSeek primario, Gemini fallback)",
        "Deploy: Docker Compose + Coolify (Hetzner)"
      ]
    },
    {
      "dot": "violet",
      "title": "Multi-tenancy",
      "items": [
        "clinicId en toda entidad y en el JWT",
        "RBAC: SUPERADMIN | CLINIC_ADMIN | PROFESSIONAL",
        "Cada clínica: sesión WAHA propia + TZ + config recordatorios",
        "Clinic.status: ACTIVE | SUSPENDED | ARCHIVED (bloquea login)",
        "Constraint DB: slot único por (clinicId, professionalId, startAt)",
        "Query guard inyecta clinicId del token (zero-trust)"
      ]
    },
    {
      "dot": "rose",
      "title": "Seguridad y compliance",
      "items": [
        "Datos de salud: solo nombre + teléfono + motivo (PII mínimo)",
        "PII redactor en logs (common/logger/pii-redactor.ts)",
        "Webhook WAHA: HMAC + token (ADR 0017)",
        "Rate-limit: bot (presupuesto LLM) + endpoint público anti-spam",
        "Cookies: SameSite=Strict, HttpOnly, Secure",
        "AdminAudit: trail completo de impersonation + mutaciones SaaS",
        "TLS en todos los endpoints (HTTPS obligatorio)"
      ]
    }
  ]
