# ── Database & Cache ─────────────────────────────────────
DATABASE_URL="postgresql://showly:showly@localhost:5432/showly"
REDIS_URL="redis://localhost:6379"

# ── Auth (JWT) ───────────────────────────────────────────
# JWT_SECRET: mínimo 32 caracteres. Nunca uses el default 'dev-*' en producción.
# Generar con: openssl rand -base64 48
JWT_SECRET="cambiar-por-secreto-de-al-menos-32-caracteres"

# En producción, si estás detrás de proxy (Cloudflare/nginx), setear a "true".
TRUST_PROXY="false"

# ── CORS ─────────────────────────────────────────────────
# Producción: whitelist de dominios permitidos, separados por coma.
CORS_ORIGINS="https://panel.showly.dev,https://showly.dev"

# ── WhatsApp (WAHA no oficial) ──────────────────────────
WAHA_BASE_URL="http://localhost:3000"
WAHA_API_KEY="cambiar"
# WAHA_DASHBOARD_PASSWORD y WHATSAPP_SWAGGER_PASSWORD DEBEN ser DISTINTOS:
# comprometido uno (ej. dashboard), el otro (swagger, permite drive del API)
# sigue seguro. Generar CADA UNO por separado con `openssl rand -base64 24`.
WAHA_DASHBOARD_USERNAME="admin"
WAHA_DASHBOARD_PASSWORD="cambiar"
WHATSAPP_SWAGGER_USERNAME="admin"
WHATSAPP_SWAGGER_PASSWORD="cambiar-distinto-del-dashboard"

# WEBHOOK_TOKEN: validación del webhook WAHA. En producción es obligatorio.
WEBHOOK_TOKEN="cambiar-por-token-hex-de-32-caracteres"

# ── LLMs (bot) ───────────────────────────────────────────
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""

# OpenCode (OpenAI-compat gateway). PLAN es el identificador del modelo.
OPENCODE_API_KEY=""
OPENCODE_BASE_URL=""
OPENCODE_PLAN=""

# Orden de fallback del router LLM (csv). Providers válidos: deepseek, opencode, gemini.
# Default si no se setea: deepseek,opencode,gemini.
LLM_PROVIDER_ORDER="deepseek,opencode,gemini"

# OpenAI embeddings para RAG FAQ (opcional).
# Si falta: POST /api/faq guarda content sin embedding, y el bot hace
# handoff a humano cuando el paciente hace una pregunta (Intent.PREGUNTA_FAQ).
OPENAI_API_KEY=""

# ── Frontend (web) ──────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Bot (WhatsApp) ─────────────────────────────────────
# Muestra "escribiendo…" antes de cada respuesta del bot + delay proporcional
# al largo (~40 chars/seg). Reduce huella de detección de bot no oficial.
# Poner "false" para respuestas instantáneas (útil en tests y dev rápido).
BOT_TYPING_ENABLED="true"

# ── Mail (Resend) ──────────────────────────────────────
# API key de Resend. Sin ella, los mails NO se envían — el backend loguea
# el intento y devuelve ok en dev (fallback). Generar en resend.com/api-keys.
RESEND_API_KEY=""
# Dirección "From" del mail. En dev: `onboarding@resend.dev` (solo llega
# al owner de la cuenta Resend). En prod: dominio verificado, ej:
# `Showly <no-reply@showly.dev>`. Ver docs de Resend > Domains.
EMAIL_FROM="Showly <onboarding@showly.us>"
# Base URL usada para armar links absolutos en los emails
# (ej: `${APP_BASE_URL}/es/invite/{token}`). En prod: dominio del panel.
APP_BASE_URL="http://localhost:3002"

# ── Environment ─────────────────────────────────────────
NODE_ENV="development"
PORT="4000"

# ── Observability: Logs (Pino + Axiom) ─────────────────
# Nivel de log: trace|debug|info|warn|error|fatal|silent.
# Default: 'debug' en dev, 'info' en prod, 'silent' en test.
LOG_LEVEL="debug"
# Pretty output para dev local. En prod dejar 'false' (JSON puro para Axiom).
LOG_PRETTY="true"
# Axiom ingest. Setear a "true" cuando querés ver logs en cloud.
# Free tier: 500GB/mes. Dataset compartido con tag env=... por deploy.
AXIOM_ENABLED="false"
AXIOM_DATASET_LOGS="showly-prod"
AXIOM_TOKEN=""
AXIOM_ORG_ID=""

# ── Observability: Errors (Sentry) ─────────────────────
# En producción SENTRY_DSN es OBLIGATORIA (fail-fast en main.ts).
# Backend
SENTRY_ENABLED="false"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
# Traces sample rate: 0.0 apagado, 1.0 todo. Con 40 clínicas + volumen bajo
# arrancar en 0.1 (10%) es prudente para no comerse cuota rápido.
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Frontend Next.js (variables NEXT_PUBLIC_* son visibles en el browser)
NEXT_PUBLIC_SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Build-time (upload sourcemaps a Sentry). Se pasa SOLO durante `next build`
# — NO debe estar en runtime env del container.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Tunneling: opcional, ver docs de Sentry. Deja vacío para no usar.
SENTRY_TUNNEL_ROUTE=""

# ── Webhook auth (WAHA) ────────────────────────────────
# Preferencia: HMAC > shared token > skip explícito. Al menos uno debe estar
# seteado en prod (fail-closed absoluto — el webhook nunca queda abierto).
# HMAC-SHA256 sobre el body raw. Setear el mismo valor en WHATSAPP_HOOK_HMAC
# del container WAHA (docker-compose.prod.yml).
WEBHOOK_HMAC_SECRET=""
# Skip auth (solo dev). NO usar en producción — se ignora si NODE_ENV=production.
# Reemplaza el fail-open dev implícito por opt-in explícito (cierra gap del
# review de seguridad Medio #2 — staging con NODE_ENV=staging).
ALLOW_WEBHOOK_WITHOUT_TOKEN="false"
